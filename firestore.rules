rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: players
// Document ID: UUID generated by the Next.js server
// Fields:
//   - name: string (required, 2-150)
//   - country: string (required, 1-80)
//   - role: string (required, batsman | bowler | all-rounder | wicketkeeper)
//   - status: string (required, active | inactive)
//   - date_of_birth, playing_hand, photo_url, stat numbers: optional
//   - odi, t20, test: map (required)
//   - custom_fields: list (required, max 100)
//   - version: number (required, the player catalog version of this write)
//   - created_at: string (required, immutable)
//   - updated_at: string (required)
//
// Collection: playerCatalog
// Document ID: current
// Fields: version (latest player change), updated_at
// The app reads this one document. When its version matches the version stored
// with the local players, nothing else is downloaded.
//
// Collection: playerChanges
// Document ID: the version number
// Fields:
//   - version: number
//   - player_id: string
//   - op: upsert | delete
//   - fields: map of only the values that changed (full player on create)
//   - removed: list of field paths to delete locally, such as odi.bowling_average
//   - created_at: string
// Query version > the app's saved version, in order, and apply each change.
//
// Collection: playerFields
// Document ID: UUID generated by the Next.js server
// Fields:
//   - name: string (required, 2-120)
//   - applies_to: string (required, batter | bowler | all-rounder | wicketkeeper)
//   - created_at: string (required, immutable)
//
// Collection: playersOfTheDay
// Document ID: UUID generated by the Next.js server
// Fields:
//   - play_date: string (required, YYYY-MM-DD)
//   - player_id: string (required)
//   - name, country, role: copied from the player so the app can read one document
//   - photo_url: string or null
//   - debut_format, wickets_format, matches_format, hundreds_format: odi | t20 | test
//   - status: string (required, pending | active | past)
//   - times_played: number (required)
//   - created_at: string (required, immutable)
//   - updated_at: string (required)
// Mobile clients signed in with Firebase Auth can read this collection.
// Query by play_date. One document is one day's mystery player.
//
// Collection: teamsOfTheDay
// Document ID: UUID generated by the Next.js server
// Fields:
//   - play_date: string (required, YYYY-MM-DD)
//   - title: string (required, 2-200)
//   - country: string (required, 1-80)
//   - team_type: string (required, team | squad)
//   - status: string (required, pending | active | past)
//   - times_played: number (required)
//   - players: list of player names (required, max 15)
//   - created_at: string (required, immutable)
//   - updated_at: string (required)
// Mobile clients signed in with Firebase Auth can read this collection.
// Query by play_date and status. Each player entry is the player's name.
//
// Collection: categories
// Document ID: UUID generated by the Next.js server
// Fields: name, status (active | inactive), daily_question_limit (1-50), created_at, updated_at
//
// Collection: questions
// Document ID: UUID generated by the Next.js server
// Fields: type (player | general | tournament | image), title, category_id, category_name,
//   status, tournament_id, image_url, option_1-4, correct_option, used, last_used_on,
//   created_at, updated_at
//
// Collection: dailyQuizzes
// Document ID: UUID generated by the Next.js server
// Fields: quiz_date, status, times_played, items (max 50, each item copies the question and options),
//   created_at, updated_at
// Collection: tournaments
// Document ID: UUID generated by the Next.js server
// Fields:
//   - name: string (required, 2-200)
//   - answers: list of completed question answers (required, max 200)
//   - created_at: string (required, immutable)
//   - updated_at: string (required)
// Tournament-specific question templates are stored in questions with tournament_id.
//
// Stat fields are checked by the Next.js server. Checking every stat here
// exceeds Firestore's 1000-expression evaluation limit and denies every write.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    function isString(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidPlayer(data) {
      return isString(data.name, 2, 150)
        && isString(data.country, 1, 80)
        && data.role in ['batsman', 'bowler', 'all-rounder', 'wicketkeeper']
        && data.status in ['active', 'inactive']
        && data.odi is map
        && data.t20 is map
        && data.test is map
        && data.custom_fields is list
        && data.custom_fields.size() <= 100
        && data.version is int
        && data.version > 0
        && data.created_at is string
        && data.updated_at is string
        && data.keys().size() <= 200;
    }

    function isValidPlayerCatalog(data) {
      return data.version is int
        && data.version >= 0
        && data.updated_at is string
        && data.keys().size() <= 4;
    }

    function isValidPlayerChange(data) {
      return data.version is int
        && data.version > 0
        && data.player_id is string
        && data.player_id.size() > 0
        && data.player_id.size() <= 80
        && data.op in ['upsert', 'delete']
        && data.fields is map
        && data.removed is list
        && data.created_at is string
        && data.keys().size() <= 10;
    }

    function isValidPlayerOfTheDay(data) {
      return isString(data.play_date, 10, 10)
        && isString(data.player_id, 1, 80)
        && isString(data.name, 2, 150)
        && isString(data.country, 1, 80)
        && (data.photo_url == null || isString(data.photo_url, 0, 4000))
        && data.role in ['batsman', 'bowler', 'all-rounder', 'wicketkeeper']
        && data.debut_format in ['odi', 't20', 'test']
        && data.wickets_format in ['odi', 't20', 'test']
        && data.matches_format in ['odi', 't20', 'test']
        && data.hundreds_format in ['odi', 't20', 'test']
        && data.status in ['pending', 'active', 'past']
        && data.times_played is int
        && data.created_at is string
        && data.updated_at is string
        && data.keys().size() <= 16;
    }

    function isValidTeam(data) {
      return isString(data.play_date, 10, 10)
        && isString(data.title, 2, 200)
        && isString(data.country, 1, 80)
        && data.team_type in ['team', 'squad']
        && data.status in ['pending', 'active', 'past']
        && data.times_played is int
        && data.players is list
        && data.players.size() <= 15
        && data.created_at is string
        && data.updated_at is string
        && data.keys().size() <= 20;
    }

    function isValidCategory(data) {
      return isString(data.name, 2, 120)
        && data.status in ['active', 'inactive']
        && data.daily_question_limit is int
        && data.daily_question_limit >= 1
        && data.daily_question_limit <= 50
        && data.created_at is string
        && data.updated_at is string
        && data.keys().size() <= 10;
    }

    function isValidQuestion(data) {
      return data.type in ['player', 'general', 'tournament', 'image']
        && isString(data.title, 8, 500)
        && data.category_id is string
        && data.category_name is string
        && data.status in ['active', 'inactive']
        && data.used is bool
        && data.created_at is string
        && data.updated_at is string
        && data.keys().size() <= 25;
    }

    function isValidDailyQuiz(data) {
      return isString(data.quiz_date, 10, 10)
        && data.status in ['pending', 'active', 'past']
        && data.times_played is int
        && data.items is list
        && data.items.size() <= 50
        && data.created_at is string
        && data.updated_at is string
        && data.keys().size() <= 15;
    }

    function isValidTournament(data) {
      return isString(data.name, 2, 200)
        && data.answers is list
        && data.answers.size() <= 200
        && data.created_at is string
        && data.updated_at is string
        && data.keys().size() <= 10;
    }

    function isValidPlayerField(data) {
      return data.keys().hasOnly(['name', 'applies_to', 'created_at'])
        && isString(data.name, 2, 120)
        && data.applies_to in ['batter', 'bowler', 'all-rounder', 'wicketkeeper']
        && data.created_at is string;
    }

    match /players/{playerId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidPlayer(request.resource.data);
      allow update: if isSignedIn() && isValidPlayer(request.resource.data)
        && (!resource.data.keys().hasAny(['created_at']) || request.resource.data.created_at == resource.data.created_at);
      allow delete: if isSignedIn();
    }

    match /playerCatalog/{docId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidPlayerCatalog(request.resource.data);
      allow delete: if false;
    }

    match /playerChanges/{changeId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidPlayerChange(request.resource.data);
      allow delete: if false;
    }

    match /playersOfTheDay/{dayId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidPlayerOfTheDay(request.resource.data);
      allow update: if isSignedIn() && isValidPlayerOfTheDay(request.resource.data)
        && request.resource.data.created_at == resource.data.created_at;
      allow delete: if isSignedIn();
    }

    match /teamsOfTheDay/{teamId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidTeam(request.resource.data);
      allow update: if isSignedIn() && isValidTeam(request.resource.data)
        && request.resource.data.created_at == resource.data.created_at;
      allow delete: if isSignedIn();
    }

    match /categories/{categoryId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidCategory(request.resource.data);
      allow update: if isSignedIn() && isValidCategory(request.resource.data)
        && request.resource.data.created_at == resource.data.created_at;
      allow delete: if isSignedIn();
    }

    match /questions/{questionId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidQuestion(request.resource.data);
      allow update: if isSignedIn() && isValidQuestion(request.resource.data)
        && request.resource.data.created_at == resource.data.created_at;
      allow delete: if isSignedIn();
    }

    match /dailyQuizzes/{quizId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidDailyQuiz(request.resource.data);
      allow update: if isSignedIn() && isValidDailyQuiz(request.resource.data)
        && request.resource.data.created_at == resource.data.created_at;
      allow delete: if isSignedIn();
    }

    match /tournaments/{tournamentId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidTournament(request.resource.data);
      allow update: if isSignedIn() && isValidTournament(request.resource.data)
        && request.resource.data.created_at == resource.data.created_at;
      allow delete: if isSignedIn();
    }

    match /playerFields/{fieldId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidPlayerField(request.resource.data);
      allow update: if isSignedIn() && isValidPlayerField(request.resource.data)
        && request.resource.data.created_at == resource.data.created_at;
      allow delete: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
