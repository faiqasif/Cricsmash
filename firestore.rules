rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: players
// Document ID: UUID generated by the Next.js server
// Fields:
//   - name: string (required, 2-150)
//   - country: string (required, 1-80)
//   - role: string (required, batsman | bowler | all-rounder | wicketkeeper)
//   - status: string (required, active | inactive)
//   - date_of_birth, playing_hand, photo_url, stat numbers: optional
//   - odi, t20, test: map (required)
//   - custom_fields: list (required, max 100)
//   - created_at: string (required, immutable)
//   - updated_at: string (required)
//
// Collection: playerFields
// Document ID: UUID generated by the Next.js server
// Fields:
//   - name: string (required, 2-120)
//   - applies_to: string (required, batter | bowler | all-rounder | wicketkeeper)
//   - created_at: string (required, immutable)
//
// Collection: teamsOfTheDay
// Document ID: UUID generated by the Next.js server
// Fields:
//   - play_date: string (required, YYYY-MM-DD)
//   - title: string (required, 2-200)
//   - country: string (required, 1-80)
//   - team_type: string (required, team | squad)
//   - status: string (required, pending | active | past)
//   - times_played: number (required)
//   - players: list of { player_id, name, country, photo_url, role, sort_order } (required, max 15)
//   - created_at: string (required, immutable)
//   - updated_at: string (required)
// Mobile clients signed in with Firebase Auth can read this collection.
// Query by play_date and status. Player details are copied onto each game.
//
// Stat fields are checked by the Next.js server. Checking every stat here
// exceeds Firestore's 1000-expression evaluation limit and denies every write.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    function isString(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidPlayer(data) {
      return isString(data.name, 2, 150)
        && isString(data.country, 1, 80)
        && data.role in ['batsman', 'bowler', 'all-rounder', 'wicketkeeper']
        && data.status in ['active', 'inactive']
        && data.odi is map
        && data.t20 is map
        && data.test is map
        && data.custom_fields is list
        && data.custom_fields.size() <= 100
        && data.created_at is string
        && data.updated_at is string
        && data.keys().size() <= 80;
    }

    function isValidTeam(data) {
      return isString(data.play_date, 10, 10)
        && isString(data.title, 2, 200)
        && isString(data.country, 1, 80)
        && data.team_type in ['team', 'squad']
        && data.status in ['pending', 'active', 'past']
        && data.times_played is int
        && data.players is list
        && data.players.size() <= 15
        && data.created_at is string
        && data.updated_at is string
        && data.keys().size() <= 20;
    }

    function isValidPlayerField(data) {
      return data.keys().hasOnly(['name', 'applies_to', 'created_at'])
        && isString(data.name, 2, 120)
        && data.applies_to in ['batter', 'bowler', 'all-rounder', 'wicketkeeper']
        && data.created_at is string;
    }

    match /players/{playerId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidPlayer(request.resource.data);
      allow update: if isSignedIn() && isValidPlayer(request.resource.data)
        && request.resource.data.created_at == resource.data.created_at;
      allow delete: if isSignedIn();
    }

    match /teamsOfTheDay/{teamId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidTeam(request.resource.data);
      allow update: if isSignedIn() && isValidTeam(request.resource.data)
        && request.resource.data.created_at == resource.data.created_at;
      allow delete: if isSignedIn();
    }

    match /playerFields/{fieldId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidPlayerField(request.resource.data);
      allow update: if isSignedIn() && isValidPlayerField(request.resource.data)
        && request.resource.data.created_at == resource.data.created_at;
      allow delete: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
